[Unit]
Description=Live 24/7 Canal PT — Nossa Senhora Aparecida
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ao_vivo_pt
EnvironmentFile=/root/ao_vivo_pt/.env
ExecStart=/usr/bin/python3 /root/ao_vivo_pt/ao_vivo_pt.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
